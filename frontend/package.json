{
  "name": "servdesk",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate:api": "openapi-typescript ../src/main/resources/static/openapi/servdesk-api.yaml -o src/app/api/servdesk-api.d.ts",
    "prestart": "npm run generate:api",
    "start": "ng serve --proxy-config proxy.conf.json",
    "prebuild": "npm run generate:api",
    "build": "ng build",
    "pretest": "npm run generate:api",
    "test": "ng test --watch=false",
    "prelint": "npm run generate:api",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@jsverse/transloco": "^8.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}

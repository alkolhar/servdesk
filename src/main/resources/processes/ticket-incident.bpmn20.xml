<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Incident lifecycle (ADR-0004, ADR-0007, ADR-0008). Every stage is one user task whose id is its
  task key, and whose outcomes (the `outcome` variable the task is completed with) are that stage's
  actions. Entering a stage projects its status onto the ticket through the single entry point,
  TicketLifecycle.enterStatus; the BPMN decides *when*, Java decides *what it means*.

    status        task key             outcomes
    OPEN          triage               start-work -> work, cancel -> closed
    IN_PROGRESS   work                 resolve -> confirm-resolution, put-on-hold -> on-hold, cancel -> closed
    PENDING       on-hold              resume -> work, cancel -> closed
    RESOLVED      confirm-resolution   close -> closed, reopen -> work
    CLOSED        (end)                terminal: a recurrence is a new ticket

  Every stage maps to exactly one of the five statuses, in every version of this file (ADR-0007):
  running tickets stay on the version they started with, and listings and SLA must not notice.
  Convention the API relies on (TicketTasks): the exclusive gateway after a stage's user task has
  one outgoing flow per outcome, *named* after it. Those names are the stage's actions — the
  catalogue is read from this file, never duplicated in Java.

  The auto-close timer on confirm-resolution comes with #116.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="https://servdesk.alkolhar.dev/processes">
  <process id="ticket-incident" name="Incident lifecycle" isExecutable="true">
    <startEvent id="start"/>
    <sequenceFlow id="start-to-triage" sourceRef="start" targetRef="triage"/>

    <!-- OPEN -->
    <userTask id="triage" name="Triage">
      <extensionElements>
        <flowable:executionListener event="start" expression="${ticketLifecycle.enterStatus(execution.processInstanceBusinessKey, 'OPEN')}"/>
      </extensionElements>
    </userTask>
    <sequenceFlow id="triage-done" sourceRef="triage" targetRef="triage-outcome"/>
    <exclusiveGateway id="triage-outcome"/>
    <sequenceFlow name="start-work" id="triage-start-work" sourceRef="triage-outcome" targetRef="work">
      <conditionExpression xsi:type="tFormalExpression">${outcome == 'start-work'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow name="cancel" id="triage-cancel" sourceRef="triage-outcome" targetRef="closed">
      <conditionExpression xsi:type="tFormalExpression">${outcome == 'cancel'}</conditionExpression>
    </sequenceFlow>

    <!-- IN_PROGRESS -->
    <userTask id="work" name="Work">
      <extensionElements>
        <flowable:executionListener event="start" expression="${ticketLifecycle.enterStatus(execution.processInstanceBusinessKey, 'IN_PROGRESS')}"/>
      </extensionElements>
    </userTask>
    <sequenceFlow id="work-done" sourceRef="work" targetRef="work-outcome"/>
    <exclusiveGateway id="work-outcome"/>
    <sequenceFlow name="resolve" id="work-resolve" sourceRef="work-outcome" targetRef="confirm-resolution">
      <conditionExpression xsi:type="tFormalExpression">${outcome == 'resolve'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow name="put-on-hold" id="work-put-on-hold" sourceRef="work-outcome" targetRef="on-hold">
      <conditionExpression xsi:type="tFormalExpression">${outcome == 'put-on-hold'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow name="cancel" id="work-cancel" sourceRef="work-outcome" targetRef="closed">
      <conditionExpression xsi:type="tFormalExpression">${outcome == 'cancel'}</conditionExpression>
    </sequenceFlow>

    <!-- PENDING -->
    <userTask id="on-hold" name="On hold">
      <extensionElements>
        <flowable:executionListener event="start" expression="${ticketLifecycle.enterStatus(execution.processInstanceBusinessKey, 'PENDING')}"/>
      </extensionElements>
    </userTask>
    <sequenceFlow id="on-hold-done" sourceRef="on-hold" targetRef="on-hold-outcome"/>
    <exclusiveGateway id="on-hold-outcome"/>
    <sequenceFlow name="resume" id="on-hold-resume" sourceRef="on-hold-outcome" targetRef="work">
      <conditionExpression xsi:type="tFormalExpression">${outcome == 'resume'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow name="cancel" id="on-hold-cancel" sourceRef="on-hold-outcome" targetRef="closed">
      <conditionExpression xsi:type="tFormalExpression">${outcome == 'cancel'}</conditionExpression>
    </sequenceFlow>

    <!-- RESOLVED -->
    <userTask id="confirm-resolution" name="Confirm resolution">
      <extensionElements>
        <flowable:executionListener event="start" expression="${ticketLifecycle.enterStatus(execution.processInstanceBusinessKey, 'RESOLVED')}"/>
      </extensionElements>
    </userTask>
    <sequenceFlow id="confirm-resolution-done" sourceRef="confirm-resolution" targetRef="confirm-resolution-outcome"/>
    <exclusiveGateway id="confirm-resolution-outcome"/>
    <sequenceFlow name="close" id="confirm-resolution-close" sourceRef="confirm-resolution-outcome" targetRef="closed">
      <conditionExpression xsi:type="tFormalExpression">${outcome == 'close'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow name="reopen" id="confirm-resolution-reopen" sourceRef="confirm-resolution-outcome" targetRef="work">
      <conditionExpression xsi:type="tFormalExpression">${outcome == 'reopen'}</conditionExpression>
    </sequenceFlow>

    <!-- CLOSED: resolved-and-closed or cancelled alike; TicketLifecycle tells them apart by resolvedAt -->
    <endEvent id="closed">
      <extensionElements>
        <flowable:executionListener event="start" expression="${ticketLifecycle.enterStatus(execution.processInstanceBusinessKey, 'CLOSED')}"/>
      </extensionElements>
    </endEvent>
  </process>
</definitions>
